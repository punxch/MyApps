{
    "schema_version": 1,
    "id": "mypaste",
    "enabled": true,
    "scoop": {
        "template": "templates/mypaste.scoop.json",
        "assets": {
            "64bit": "mypaste-{version}-windows-x64.zip"
        }
    },
    "homebrew": {
        "kind": "cask",
        "template": "templates/mypaste.cask.rb",
        "assets": {
            "arm64": "mypaste-{version}-macos-arm64.dmg"
        }
    }
}
