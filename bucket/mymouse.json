{
    "description": "Share keyboard, mouse and clipboard between Windows and macOS computers",
    "homepage": "https://github.com/punxch/MyApps/blob/main/docs/apps/mymouse.md",
    "license": "Proprietary",
    "bin": "mymouse.exe",
    "shortcuts": [
        [
            "mymouse_settings.exe",
            "MyMouse"
        ]
    ],
    "notes": [
        "Windows 10/11 x64. Launch MyMouse from the Start menu; the mymouse command provides the CLI.",
        "Pair both computers and confirm the matching code before sharing. Ctrl+Alt+Shift+Esc releases remote control.",
        "Disable login startup and quit MyMouse from the tray before uninstalling. Quit before upgrading, then reopen the app.",
        "User settings and pairing data are stored outside the package and are retained when uninstalling."
    ],
    "post_install": [
        "$runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$startup = (Get-ItemProperty -LiteralPath $runKey -Name MyMouse -ErrorAction SilentlyContinue).MyMouse",
        "if ($startup -match '^\"(?<exe>[^\"\\r\\n]+\\\\mymouse[.]exe)\"\\s+(?:--background\\s+)?--data-dir\\s+\"(?<profile>[^\"\\r\\n]+)\"\\s+daemon\\s+run\\s*$') {",
        "    $oldExecutable = $Matches.exe",
        "    $profile = $Matches.profile",
        "    $packageRoot = [IO.Path]::GetFullPath((Split-Path -Parent $dir))",
        "    $oldPackageRoot = [IO.Path]::GetFullPath((Split-Path -Parent (Split-Path -Parent $oldExecutable)))",
        "    if ([string]::Equals($packageRoot, $oldPackageRoot, [StringComparison]::OrdinalIgnoreCase)) {",
        "        $executable = Join-Path $packageRoot 'current\\mymouse.exe'",
        "        $value = '\"{0}\" --background --data-dir \"{1}\" daemon run' -f $executable, $profile",
        "        Set-ItemProperty -LiteralPath $runKey -Name MyMouse -Value $value -ErrorAction Stop",
        "    }",
        "}"
    ],
    "version": "0.1.2",
    "architecture": {
        "64bit": {
            "url": "https://github.com/punxch/MyApps/releases/download/mymouse-v0.1.2/mymouse-0.1.2-windows-x64.zip",
            "hash": "9fe5170135af76cfacf150fcc6b37fd9eb88db790e90bc0fac13665785240ceb"
        }
    }
}
